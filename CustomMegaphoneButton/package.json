{
  "name": "custom-megaphone-button",
  "description": "A template for creating custom MegaphoneButton for metatell",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run set-uuid && env-cmd -f .uuid.env vite",
    "build": "rimraf dist && npm run set-uuid && env-cmd -f .uuid.env vite build && env-cmd -f .uuid.env node ./scripts/add_metadata.js && node ./scripts/archive_dist.js",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "run-s -c lint:*",
    "lint:tsc": "tsc --noEmit",
    "lint:prettier": "prettier --check 'src/**/*.{js,jsx,ts,tsx,css,scss}'",
    "lint:eslint": "eslint ./src",
    "lint-fix": "run-s -c lint-fix:*",
    "lint-fix:prettier": "prettier --write 'src/**/*.{js,jsx,ts,tsx,css,scss}'",
    "lint-fix:eslint": "eslint --fix ./src",
    "set-uuid": "node ./scripts/set_uuid.js > .uuid.env"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.9.4",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^11.2.7",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/react-modal": "^3.16.3",
    "@typescript-eslint/eslint-plugin": "^7.17.0",
    "@typescript-eslint/parser": "^7.17.0",
    "@vitejs/plugin-react": "^5.1.2",
    "adm-zip": "^0.5.16",
    "env-cmd": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.35.0",
    "jsdom": "^28.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "3.3.3",
    "rimraf": "^6.0.1",
    "sass": "^1.82.0",
    "typescript": "^5.5.4",
    "uuid": "^13.0.0",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-toastify": "^9.1.3",
    "react-tooltip": "^5.28.0"
  },
  "volta": {
    "node": "24.11.0",
    "npm": "11.6.2"
  }
}
