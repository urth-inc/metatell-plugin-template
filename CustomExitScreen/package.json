{
  "name": "custom-access-denied-screen-template",
  "description": "A template for creating a custom access denied screen for metatell",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run set-uuid && env-cmd -f .uuid.env vite",
    "build": "npm run set-uuid && env-cmd -f .uuid.env vite build",
    "preview": "vite preview",
    "lint:tsc": "tsc --noEmit",
    "lint:biome": "biome check src",
    "lint": "npm run lint:tsc && npm run lint:biome",
    "lint-fix": "biome check --write src",
    "set-uuid": "node ./scripts/set_uuid.js > .uuid.env"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@module-federation/vite": "1.9.4",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.1.2",
    "env-cmd": "11.0.0",
    "typescript": "5.9.3",
    "uuid": "13.0.0",
    "vite": "6.4.1"
  },
  "volta": {
    "node": "24.11.0",
    "npm": "11.6.2"
  }
}
