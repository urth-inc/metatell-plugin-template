{
  "name": "custom-profile-modal",
  "description": "A template for creating CustomProfileModal for metatell",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run set-uuid && env-cmd -f .uuid.env vite",
    "build": "rimraf dist && npm run set-uuid && env-cmd -f .uuid.env vite build && env-cmd -f .uuid.env node ./scripts/add_metadata.js && node ./scripts/archive_dist.js",
    "preview": "vite preview",
    "test": "vitest run",
    "lint:tsc": "tsc --noEmit",
    "lint:biome": "biome check src",
    "lint": "npm run lint:tsc && npm run lint:biome",
    "lint-fix": "biome check --write src",
    "set-uuid": "node ./scripts/set_uuid.js > .uuid.env"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@module-federation/vite": "^1.9.4",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^11.2.7",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/react-modal": "^3.16.3",
    "@vitejs/plugin-react": "^5.1.2",
    "adm-zip": "^0.5.16",
    "env-cmd": "^10.1.0",
    "jsdom": "^28.0.0",
    "rimraf": "^6.0.1",
    "sass": "^1.77.8",
    "typescript": "^5.5.4",
    "uuid": "^13.0.0",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-modal": "^3.16.1"
  },
  "volta": {
    "node": "20.14.0",
    "npm": "10.8.1"
  }
}
